# ─── Base de données ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# URL publique du site (utilisée dans les liens des notifications)
SITE_URL=https://www.uorahal.ci

# ─── Administration (/admin) ───────────────────────────────────────
# Mot de passe du tableau de bord des commandes. Sans cette variable, /admin est verrouillé.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ─── 1. Telegram (alerte immédiate pour l'équipe — gratuit) ────────
# 1. Dans Telegram, parlez à @BotFather → /newbot → copiez le token.
# 2. Ajoutez le bot à votre groupe ou discutez avec lui, puis récupérez le chat_id
#    via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 2. E-mail via Resend (équipe + client) ────────────────────────
# Créez une clé sur https://resend.com/api-keys et vérifiez un domaine (ex. uorahal.ci).
RESEND_API_KEY=
# Expéditeur autorisé, ex. "UORAHAL <commandes@uorahal.ci>"
NOTIFY_FROM_EMAIL=

# ─── 3. WhatsApp Cloud API (confirmation client) ───────────────────
# Meta Business → WhatsApp → API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Modèles approuvés par Meta (catégorie « Utility », langue fr).
# Chaque modèle doit avoir 3 variables dans cet ordre : {{1}} prénom, {{2}} n° commande, {{3}} total.
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_ORDER_VALIDATED=
WHATSAPP_TEMPLATE_LANG=fr
